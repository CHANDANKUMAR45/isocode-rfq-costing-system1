{
  "name": "isocode-rfq-costing-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server:install": "npm --prefix server install",
    "client:install": "npm --prefix client install",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "db:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=./prisma/schema.prisma",
    "db:seed": "npm --prefix server run seed",
    "test": "npm --prefix server test"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
