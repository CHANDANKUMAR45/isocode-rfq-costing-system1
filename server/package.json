{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "prisma:push": "prisma db push --schema=../prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=../prisma/schema.prisma",
    "prisma:generate:postgres": "prisma generate --schema=../prisma/postgresql/schema.prisma",
    "prisma:generate:all": "npm run prisma:generate && npm run prisma:generate:postgres",
    "prisma:migrate:deploy:postgres": "prisma migrate deploy --schema=../prisma/postgresql/schema.prisma",
    "migrate:sqlite-to-postgres": "tsx src/scripts/migrateSqliteToPostgres.ts",
    "verify:sqlite-postgres": "tsx src/scripts/migrateSqliteToPostgres.ts --verify-only",
    "prisma:labour-migration": "prisma db execute --schema=../prisma/schema.prisma --file=../prisma/migrations/20261108171200_version_labour_rates/migration.sql",
    "test:gemini": "tsx src/scripts/testGeminiConnection.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/pdfkit": "^0.13.8",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
